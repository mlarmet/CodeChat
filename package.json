{
	"name": "codechat",
	"displayName": "CodeChat",
	"description": "Local chat with another VSCode",
	"version": "0.1.0",
	"publisher": "mlarmet",
	"private": true,
	"engines": {
		"vscode": "^1.110.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./dist/extension.js",
	"contributes": {
		"configuration": {
			"title": "CodeChat",
			"properties": {
				"CodeChat.port": {
					"type": "number",
					"default": 12121,
					"minimum": 1,
					"maximum": 65535,
					"description": "Port du serveur"
				},
				"CodeChat.notification": {
					"type": "boolean",
					"default": true,
					"description": "Active les notifications de nouveaux messages"
				}
			}
		},
		"commands": [
			{
				"command": "CodeChat.about",
				"title": "Informations",
				"icon": "$(info)"
			},
			{
				"command": "CodeChat.clearMessages",
				"title": "Supprimer les messages",
				"icon": "$(clear-all)"
			},
			{
				"command": "CodeChat.logout",
				"title": "Quitter la conversation",
				"icon": "$(sign-out)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "CodeChat.about",
					"when": "view == CodeChat.view",
					"group": "navigation@1"
				},
				{
					"command": "CodeChat.clearMessages",
					"when": "view == CodeChat.view && CodeChat.logged",
					"group": "navigation@2"
				},
				{
					"command": "CodeChat.logout",
					"when": "view == CodeChat.view && CodeChat.logged",
					"group": "navigation@3"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "CodeChat",
					"title": "CodeChat",
					"icon": "resources/icons/comment-discussion.svg"
				}
			]
		},
		"views": {
			"CodeChat": [
				{
					"id": "CodeChat.view",
					"name": "CodeChat",
					"icon": "resources/icons/comment-discussion.svg",
					"type": "webview"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.mjs",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.mjs --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run check-types && npm run lint && node esbuild.mjs --production",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"check-types": "tsc --noEmit",
		"lint": "eslint src",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "22.x",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/vscode": "^1.110.0",
		"@vscode/test-cli": "^0.0.12",
		"@vscode/test-electron": "^2.5.2",
		"esbuild": "^0.27.3",
		"eslint": "^9.39.3",
		"npm-run-all": "^4.1.5",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"vite": "^8.0.0"
	},
	"dependencies": {
		"@types/ws": "^8.18.1",
		"@vscode-elements/react-elements": "^2.4.0",
		"date-fns": "^4.1.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"ws": "^8.21.3",
		"zustand": "^5.0.12"
	}
}
